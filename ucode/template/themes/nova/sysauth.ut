{% include('header', { blank_page: true }) %}
<main class="nova-login-card">
 <img src="{{ media }}/logo.svg" width="48" height="48" alt="">
 <p class="nova-eyebrow">NOVA / {{ _('Network console') }}</p>
 <h1>{{ _('Authorization Required') }}</h1>
 <form method="post">
 {% if (fuser): %}<div class="alert-message error">{{ _('Invalid username and/or password! Please try again.') }}</div>{% endif %}
 <label for="luci_username">{{ _('Username') }}</label>
 <input id="luci_username" name="luci_username" type="text" value="{{ entityencode(duser, true) }}" autocomplete="username" required>
 <label for="luci_password">{{ _('Password') }}</label>
 <input id="luci_password" name="luci_password" type="password" autocomplete="current-password" autofocus>
 <button class="cbi-button cbi-button-apply" type="submit">{{ _('Log in') }}</button>
 </form>
</main>
{% include('footer', { blank_page: true }) %}
